<script>
        // Simple drawer toggle logic
        document.addEventListener('DOMContentLoaded', () => {
            const drawer = document.getElementById('nav-drawer');
            const menuBtn = document.querySelector('button[aria-label="Menu"]'); // Assuming you add aria-label if needed, or select by class
            const closeBtn = document.getElementById('close-drawer');
            
            // Re-select menu button more specifically since we didn't add an ID
            const headerMenuBtn = document.querySelector('header button');

            if(headerMenuBtn && drawer && closeBtn) {
                headerMenuBtn.addEventListener('click', () => {
                    drawer.classList.remove('-translate-x-full');
                });

                closeBtn.addEventListener('click', () => {
                    drawer.classList.add('-translate-x-full');
                });
            }
        });
    </script>
